<?xml version="1.0" encoding="utf-8"?>

<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android">

    <Preference
        android:key="apply_security_changes"
        android:title="@string/apply_security_changes"
        android:summary="@string/apply_security_changes_summary" />

    <EditTextPreference
        android:key="device_lock_delay"
        android:title="@string/device_lock_delay"
        android:summary="@string/device_lock_delay_summary"
        android:defaultValue="-1"
        android:inputType="numberSigned" />

    <PreferenceCategory android:title="Lock-screen authentication restrictions">
        <SwitchPreferenceCompat
            android:key="policy_disable_fingerprint"
            android:title="@string/policy_disable_fingerprint"
            android:summary="@string/policy_disable_fingerprint_summary"
            android:persistent="false" />
        <SwitchPreferenceCompat
            android:key="policy_disable_face"
            android:title="@string/policy_disable_face"
            android:summary="@string/policy_disable_face_summary"
            android:persistent="false" />
        <SwitchPreferenceCompat
            android:key="policy_disable_iris"
            android:title="@string/policy_disable_iris"
            android:summary="@string/policy_disable_iris_summary"
            android:persistent="false" />
        <SwitchPreferenceCompat
            android:key="policy_disable_trust_agents"
            android:title="@string/policy_disable_trust_agents"
            android:summary="@string/policy_disable_trust_agents_summary"
            android:persistent="false" />
    </PreferenceCategory>

    <net.typeblog.shelter.ui.TemporaryActionPreference
        android:key="lock_phone_now"
        android:title="Lock Phone Now"
        android:summary="Press to queue an immediate device lock" />

    <net.typeblog.shelter.ui.TemporaryActionPreference
        android:key="apply_maximum_work_profile_security"
        android:title="Apply Maximum Work Profile Security"
        android:summary="Permanently apply the configured maximum security policy to the Work Profile" />

</PreferenceScreen>
